# ไฟล์ Environment Variables จริง (ห้ามหลุดขึ้น GitHub เด็ดขาด)
.env
.env.*
!.env.example

# ไฟล์สำรอง
latest/

# ของที่ไม่ควรขึ้น Space
__pycache__/
*.pyc
logs/
# snapshot ต่อรอบใหญ่ ~5MB — ผลสรุปอยู่ใน MLflow และ gate_snapshots/<label>.json แล้ว
training/gate_snapshots/prompt_*.json
training/out/
# log ทดสอบรูป (IMAGE_TEST_LOG=1) — ของดิบของผู้ทดสอบ ไม่เข้า repo · ตาราง CSV ที่เติมผลแล้วเก็บเองตามต้องการ
image_test.log
