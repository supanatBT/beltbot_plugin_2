# คัดลอกไฟล์นี้เป็น .env ที่โฟลเดอร์เดียวกัน แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env
# ใส่ค่าเปล่า ๆ ห้ามมีเครื่องหมายคำพูดครอบ — run_app.ps1 ไม่ตัดคำพูด (403 · API_KEY_INVALID เจอ 10 ต.ค.)

# คีย์ Gemini (ชื่อตัวแปรต้องตรงกับที่ chatbot_v5.py อ่าน)
GEMINI_API_KEY=

# ต้องตรงกับ PROXY_SECRET ใน web/.env.local เป๊ะ
# สร้างด้วย: python -c "import secrets;print(secrets.token_urlsafe(32))"
PROXY_SECRET=

# ล็อกรุ่นโมเดล (22 ต.ค.) — ใส่ชื่อรุ่นตายตัวที่ได้จาก python probe_model.py หรือหน้า Usage ใน AI Studio
# 23 ต.ค.: ล็อก gemini-3.8-flash — ผลทดสอบ fix8–fix10 · กราฟ 33/33 มาจากรุ่นนี้ทุกเทิร์น
# ว่าง = gemini-3.8-flash (ค่าตั้งต้นในโค้ด) · ใส่ชื่อที่ลงท้าย -latest บอตจะพิมพ์คำเตือนตอนเริ่ม
GEMINI_MODEL=gemini-3.8-flash

# จำกัด thinking ของ Gemini ให้ตอบเร็วขึ้น (13 ต.ค.) — minimal | low | medium | high · ว่าง = ไม่จำกัด (แบบเดิม)
# ต้องติดตั้งก่อน: pip install "google-genai==2.8.0" "pydantic==2.11.10" "pydantic-core==2.33.2"
# ผลทดสอบทั้งหมดตั้งแต่ 13 ต.ค. ใช้ low
GEMINI_THINKING=low

# รันในเครื่องไม่ต้องดึงไฟล์จาก Hugging Face — ปล่อยว่างไว้
ASSETS_REPO=
HF_TOKEN=

# จำกัดจำนวนครั้ง — ตอนทดสอบในเครื่องตั้งให้สูงไว้ กันโดนบล็อกตัวเอง
RL_PER_MINUTE=120
RL_PER_HOUR=2000
RL_IMAGES_PER_HOUR=200
GLOBAL_PER_DAY=100000
