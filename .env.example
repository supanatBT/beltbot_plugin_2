# คัดลอกไฟล์นี้เป็น .env ที่โฟลเดอร์เดียวกัน แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env

# คีย์ Gemini (ชื่อตัวแปรต้องตรงกับที่ chatbot_v5.py อ่าน)
GEMINI_API_KEY=""

# ต้องตรงกับ PROXY_SECRET ใน web/.env.local เป๊ะ
# สร้างด้วย: python -c "import secrets;print(secrets.token_urlsafe(32))"
PROXY_SECRET=""

# รันในเครื่องไม่ต้องดึงไฟล์จาก Hugging Face — ปล่อยว่างไว้
ASSETS_REPO=
HF_TOKEN=

# จำกัดจำนวนครั้ง — ตอนทดสอบในเครื่องตั้งให้สูงไว้ กันโดนบล็อกตัวเอง
RL_PER_MINUTE=120
RL_PER_HOUR=2000
RL_IMAGES_PER_HOUR=200
GLOBAL_PER_DAY=100000
